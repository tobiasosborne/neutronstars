# https://editorconfig.org/
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{jl,py,yml,yaml,toml}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false   # markdown trailing spaces = hard line breaks

[Makefile]
indent_style = tab
