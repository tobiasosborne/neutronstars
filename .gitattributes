# Binary assets — never let Git apply text/EOL normalisation.
*.ppm binary
*.png binary
*.gif binary
*.pdf binary
*.dat binary
*.csv binary
*.tar.gz binary
*.jpg binary
*.jpeg binary

# Source files — explicit LF line endings (avoid Windows CRLF on .jl/.tex/.md)
*.jl text eol=lf
*.tex text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
